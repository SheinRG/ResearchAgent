# === AI Research Agent — Root Environment Variables ===
# These are passed to Docker Compose services

# --- Groq (Cloud LLM) ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b

# --- Serper (Search API) ---
SERPER_API_KEY=your-serper-api-key-here

# --- Tavily (search + read API; optional, recommended) ---
# Free key at https://app.tavily.com. When set, replaces Serper search + scraping.
TAVILY_API_KEY=
USE_TAVILY_SEARCH=true

# --- Auth ---
AUTH_SECRET=change-me-in-production-use-a-random-string
GOOGLE_CLIENT_ID=your-google-client-id-here
# New accounts per IP per rolling 24h; 0 disables. Not a budget guard — the
# credit ceilings below are global and cannot be bypassed by making accounts.
# This stops a signup loop from burning the shared daily allowance and dropping
# every real visitor into degraded mode. Generous because offices and campuses
# share one address.
REGISTRATIONS_PER_IP_PER_DAY=5

# --- Search retries ---
# Serper and Tavily used to return no results on the first timeout or 5xx, which
# is indistinguishable from "the web has nothing on this". Attempts are billed
# by the provider and counted against the ceilings below, and the deadline caps
# the worst case: at a 20s provider timeout, three attempts would otherwise be a
# 60s wall on the slowest step in the pipeline.
SEARCH_MAX_RETRIES=2
SEARCH_RETRY_BASE_DELAY=0.5
SEARCH_RETRY_DEADLINE=25

# --- Anonymous demo mode + spend ceiling ---
# Logged-out visitors get a few real queries before the signup wall. The
# per-visitor number is a conversion limit; the credit ceilings are what
# protect the free tier. Sized against Tavily's 1,000 credits/month, where one
# research run bills up to 4. See backend/app/services/budget.py.
ANONYMOUS_DEMO_ENABLED=true
ANON_FREE_QUERIES=3
# Raise ANON_DAILY_SEARCH_CREDITS for a launch day — the monthly ceiling still
# backstops it, so a burst cannot become a habit.
ANON_DAILY_SEARCH_CREDITS=40
DAILY_SEARCH_CREDITS=120
MONTHLY_SEARCH_CREDITS=600
DAILY_COST_BUDGET_USD=0.25

# --- Observability (optional) ---
# Leave the DSNs blank to disable error tracking. Set them to Sentry DSNs to enable.
ENVIRONMENT=development
SENTRY_DSN=                  # backend (FastAPI) errors
NEXT_PUBLIC_SENTRY_DSN=      # frontend (Next.js) errors — inlined into the client bundle at build time
