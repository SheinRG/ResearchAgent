# ===== Secrets / Environment =====
.env
.env.*
backend/.env
backend/.env.*
**/.env
**/.env.local
# ...but always keep the example templates (any directory)
!.env.example
!**/.env.example

# ===== Python (backend) =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== Node / Next (frontend) =====
node_modules/
.next/
out/
build/
dist/

# ===== Eval harness =====
# Per-run output. The committed baseline.json is the file that matters; results
# are uploaded as a CI artifact instead of versioned.
backend/evals/results/

# Exception: citation-judge predictions. They hold pair ids, verdicts and
# scores — no scraped text — and they are the audit trail for a pre-registered
# claim: timestamps earlier than the gold labels are what shows the predictions
# were not made with the answers in hand. Also expensive to regenerate, since
# each one costs Groq calls against a per-minute token cap.
!backend/evals/results/
backend/evals/results/*
!backend/evals/results/judge/
!backend/evals/results/judge/*.jsonl

# Captured citation-judge candidates. Held out deliberately: the records embed
# full extracted page text from third-party sites, which is not ours to
# redistribute. The curated, licence-checked dataset gets published separately;
# this is the raw working file.
backend/evals/data/

# ===== Fine-tune =====
# The built training set. Large, and derived from CC BY-SA corpora, so
# redistributing it here would quietly put the repo's MIT licence over
# share-alike data — see finetune/LICENCES.md. It is rebuildable from
# build_dataset.py, which is the point of committing the builder instead.
finetune/data/

# Exception: the build report. Row counts, per-source drop tallies and the
# class balance — no dataset text. It is what lets a reader check the training
# set's composition without downloading it, so it belongs in git for the same
# reason the judge predictions do.
!finetune/data/
finetune/data/*
!finetune/data/*.report.json

# Scratch files from local smoke-testing (may contain auth tokens).
tok.tmp
*.tmp
scratch-*.txt

# ===== Local-only notes =====
# This repo is public. Anything named *.local.md stays out of it —
# SECURITY-NOTES.local.md describes unfixed weaknesses in actionable detail.
*.local.md

# ===== Logs / OS / Editor =====
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/
