# ===== Secrets / Environment =====
.env
.env.*
backend/.env
backend/.env.*
**/.env
**/.env.local
# ...but always keep the example templates (any directory)
!.env.example
!**/.env.example

# ===== Python (backend) =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== Node / Next (frontend) =====
node_modules/
.next/
out/
build/
dist/

# ===== Eval harness =====
# Per-run output. The committed baseline.json is the file that matters; results
# are uploaded as a CI artifact instead of versioned.
backend/evals/results/

# Captured citation-judge candidates. Held out deliberately: the records embed
# full extracted page text from third-party sites, which is not ours to
# redistribute. The curated, licence-checked dataset gets published separately;
# this is the raw working file.
backend/evals/data/

# Scratch files from local smoke-testing (may contain auth tokens).
tok.tmp
*.tmp
scratch-*.txt

# ===== Local-only notes =====
# This repo is public. Anything named *.local.md stays out of it —
# SECURITY-NOTES.local.md describes unfixed weaknesses in actionable detail.
*.local.md

# ===== Logs / OS / Editor =====
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/
